# Шаблон доступов для автоматической настройки CI/CD.
# Скопируй в .ci-setup.env и заполни значения (файл в .gitignore).
#   cp .ci-setup.env.example .ci-setup.env

# ==================== GitHub ====================
# PAT (classic) со scope: repo, read:packages, workflow
# Создать: github.com -> Settings -> Developer settings -> Tokens (classic)
GITHUB_TOKEN=
GITHUB_REPO=Yukky887/WebChatTP

# ==================== Portainer ====================
PORTAINER_URL=http://sup5.tradesoft.corp:9000
# API-токен: Portainer -> (аватар) My account -> Access tokens -> Add access token
PORTAINER_API_KEY=

# ==================== Значения для стеков (можно свои) ====================
