# ==================== БАЗА ДАННЫХ ====================
POSTGRES_USER=partsai
POSTGRES_PASSWORD=CHANGE_ME_STAGING_PASSWORD
POSTGRES_DB=partsai_staging
DATABASE_URL=postgresql+asyncpg://partsai:CHANGE_ME_STAGING_PASSWORD@postgres:5432/partsai_staging

# ==================== JWT ====================
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ==================== QDRANT / WEAVIATE ====================
QDRANT_URL=http://192.168.128.123:6333
WEAVIATE_URL=http://192.168.128.123:6789

# ==================== LLM ПРОВАЙДЕРЫ ====================
OLLAMA_URL=http://192.168.128.123:6790
LLAMACPP_URL=http://192.168.0.254:8080/v1
ROUTERAI_URL=https://routerai.ru/api/v1
ROUTERAI_API_KEY=CHANGE_ME

# ==================== МОДЕЛИ ====================
EMBEDDING_DOCS_MODEL=BAAI/bge-m3
EMBEDDING_TICKETS_MODEL=qwen/qwen3-embedding-4b

# ==================== ПОРТЫ (хост) ====================
BACKEND_PORT=8001
FRONTEND_PORT=3001
